      "dependencies": ["Services"],
      "configPrefixes": ["TEMPLATE_EXAMPLE_COMMAND_"],
      "hostScopes": ["CommandFlow"],
      "armScopes": ["CommandFlow"],
      "buildPresets": ["build-g3519-command-flow-debug", "build-g3519-command-flow-release"]
    },
    {
      "id": "Watchdog",
