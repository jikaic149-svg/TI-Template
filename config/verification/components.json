{
  "schemaVersion": 1,
  "globalInputs": [
    "CMakeLists.txt",
    "CMakePresets.json",
    "config/core_config.h",
    "config/cmake",
    "config/verification",
    "tests/run_gcc_tests.ps1",
    "tests/run_arm_compile.ps1",
    "tools/project.ps1",
    "tools/check_template.ps1",
    "tools/lib"
  ],
  "contextInputs": [
    "AGENTS.md",
    "README.md",
    "docs/DEVICE_PARAMETERS.md",
    "docs/WATCHDOG.md"
  ],
  "components": [
    {
      "id": "Watchdog",
      "description": "全局健康策略、Device 门面和两颗 MCU 的 WWDT BSP",
