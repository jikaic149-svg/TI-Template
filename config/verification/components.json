      "dependencies": [],
      "configPrefixes": [],
      "hostScopes": ["Watchdog"],
      "armScopes": ["Watchdog"],
      "buildPresets": [
        "build-g3507-debug",
        "build-g3507-release",
        "build-g3519-debug",
        "build-g3519-release"
      ]
    },
    {
      "id": "Communication",
      "description": "Serial、LoRa、Vision Device 与蓝牙/LoRa 通信 Mode",
      "inputs": [
        "Device/Communication",
        "Mode/Communicate",
        "tests/lora",
        "tests/mode_communicate"
