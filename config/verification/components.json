    {
      "id": "LineTracking",
      "description": "八路循迹算法、Device 与 Car Tracking Mode",
      "inputs": [
        "APP/Algorithm/LineTracking",
        "Device/Sensor/LineTracking",
        "Mode/Car/Tracking",
        "tests/line_tracking_uart"
      ],
      "dependencies": ["Navigation"],
      "hostScopes": ["LineTracking"],
      "armScopes": [],
      "buildPresets": []
    },
