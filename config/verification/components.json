      "armScopes": ["Navigation"],
      "buildPresets": [
        "build-g3519-feature-smoke-debug",
        "build-g3519-feature-smoke-release"
      ]
    },
    {
      "id": "LineTracking",
      "description": "八路循迹算法、Device 与 Car Tracking Mode",
      "inputs": [
        "APP/Algorithm/LineTracking",
        "Device/Sensor/LineTracking",
        "Mode/Car/Tracking",
        "tests/line_tracking_uart"
