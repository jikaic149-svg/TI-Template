      "dependencies": ["Watchdog", "Communication", "IMU", "Motor", "Navigation", "LineTracking"],
      "hostScopes": [],
      "armScopes": [],
      "buildPresets": [
        "build-g3507-debug",
        "build-g3507-release",
        "build-g3519-debug",
        "build-g3519-release"
      ]
