      "dependencies": ["Navigation"],
      "configPrefixes": ["TEMPLATE_LINE_"],
      "hostScopes": ["LineTracking"],
      "armScopes": ["LineTracking"],
      "buildPresets": [
        "build-g3519-feature-smoke-debug",
        "build-g3519-feature-smoke-release"
      ]
    },
    {
      "id": "Gimbal",
      "description": "云台控制、稳定、视觉、标定与调度 Mode",
      "inputs": [
        "Mode/Gimbal"
      ],
      "dependencies": [],
      "configPrefixes": ["TEMPLATE_GIMBAL_"],
      "hostScopes": [],
      "armScopes": ["Gimbal"],
      "buildPresets": [
        "build-g3519-feature-smoke-debug",
        "build-g3519-feature-smoke-release"
      ]
    },
    {
      "id": "Optional",
      "description": "未归入业务组件的通用算法、输入、执行器与存储 Device",
      "inputs": [
        "APP/Algorithm/CMakeLists.txt",
        "APP/Algorithm/ADRC",
        "APP/Algorithm/CRC",
        "APP/Algorithm/Filter",
        "APP/Algorithm/LQR",
        "APP/Algorithm/Packet",
        "APP/Algorithm/ReliableLink",
        "APP/Algorithm/SPSC_Ring",
        "Device/CMakeLists.txt",
        "Device/Input/Key",
        "Device/Actuator/LED",
        "Device/Actuator/PowerSwitch",
        "Device/Actuator/QD4310",
        "Device/Actuator/RGB",
        "Device/Actuator/Servo",
        "Device/Sensor/Encoder",
        "Device/Storage/Flash"
      ],
      "dependencies": [],
      "configPrefixes": [],
      "hostScopes": [],
      "armScopes": ["Optional"],
      "buildPresets": [
        "build-g3519-feature-smoke-debug",
        "build-g3519-feature-smoke-release"
      ]
