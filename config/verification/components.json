      "dependencies": [],
      "configPrefixes": [],
      "hostScopes": ["Motor"],
      "armScopes": ["Motor"],
      "buildPresets": [
        "build-g3519-at8236-debug",
        "build-g3519-at8236-release",
        "build-g3519-feature-smoke-debug",
        "build-g3519-feature-smoke-release"
      ]
    },
