      "description": "PID、车辆通用控制与融合惯导 Mode",
      "inputs": [
        "APP/Algorithm/PID",
        "Mode/Car/Control",
        "Mode/Car/Navigation",
        "Mode/Car/Spin",
        "Mode/Car/include",
        "Mode/Car/src",
        "tests/fused_navigation_mode"
