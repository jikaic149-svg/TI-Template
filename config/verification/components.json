{
  "schemaVersion": 2,
  "globalInputs": [
    "CMakeLists.txt",
    "CMakePresets.json",
    "config/cmake",
    "config/verification",
    "tests/run_gcc_tests.ps1",
    "tests/run_arm_compile.ps1",
    "tools/project.ps1",
    "tools/check_template.ps1",
    "tools/lib"
  ],
  "coreConfig": "config/core_config.h",
  "contextInputs": [
    "AGENTS.md",
    "README.md",
    "docs/DEVICE_PARAMETERS.md",
    "docs/WATCHDOG.md"
  ],
  "components": [
    {
      "id": "Message",
      "description": "静态 Pub/Sub、FIFO 和 Latest Value，含 FreeRTOS 移植",
      "inputs": ["Core", "tests/message"],
      "dependencies": [],
      "configPrefixes": [],
      "hostScopes": ["Message"],
      "armScopes": ["Message"],
      "buildPresets": ["build-g3519-feature-smoke-debug", "build-g3519-feature-smoke-release",
        "build-g3519-command-flow-debug", "build-g3519-command-flow-release"]
    },
    {
      "id": "Services",
      "description": "简单行输入与可选 CRC 数据包服务",
      "inputs": ["Service", "APP/Algorithm/Packet", "tests/services"],
      "dependencies": ["Message"],
      "configPrefixes": [],
      "hostScopes": ["Services"],
      "armScopes": ["Services"],
      "buildPresets": ["build-g3519-feature-smoke-debug", "build-g3519-feature-smoke-release",
        "build-g3519-command-flow-debug", "build-g3519-command-flow-release"]
