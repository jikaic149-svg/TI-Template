    {
      "id": "Firmware",
      "description": "模板公共胶水、BSP、Task 与 FreeRTOS",
      "inputs": [
        "main.c",
        "BSP",
        "Task",
        "FreeRTOS"
      ],
      "dependencies": ["Watchdog"],
      "configPrefixes": ["TEMPLATE_TASK_"],
      "hostScopes": [],
      "armScopes": [],
      "buildPresets": [
        "build-g3507-debug",
        "build-g3507-release",
        "build-g3519-debug",
        "build-g3519-release"
      ]
