      "dependencies": [],
      "configPrefixes": [],
      "hostScopes": ["Communication"],
      "armScopes": ["Communication"],
      "buildPresets": [
        "build-g3519-feature-smoke-debug",
        "build-g3519-feature-smoke-release"
      ]
    },
    {
      "id": "IMU",
      "description": "Mahony、双 IMU 融合以及统一和具体 IMU Device",
