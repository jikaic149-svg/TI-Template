      "description": "Mahony、双 IMU 融合以及统一和具体 IMU Device",
      "inputs": [
        "APP/Algorithm/Mahony",
        "APP/Algorithm/IMUFusion",
        "Device/Sensor/IMU",
        "tests/imu_fusion",
        "tests/single_imu",
        "tests/lingke_m0"
      ],
      "dependencies": [],
      "hostScopes": ["IMU"],
      "armScopes": ["IMU"],
      "buildPresets": []
    },
    {
      "id": "Motor",
      "description": "电机 Device、型号参数和 TB6612/AT8236 BSP 集成",
      "inputs": [
        "Device/Actuator/Motor",
        "BSP/bsp_motor.h",
        "BSP/MSPM0G3507/bsp_motor.c",
        "BSP/MSPM0G3519/bsp_motor.c",
        "BSP/MSPM0G3519/bsp_motor_at8236.c",
        "tests/motor_at8236",
        "tests/motor_tb6612",
        "tests/motor_models"
      ],
      "dependencies": [],
      "hostScopes": ["Motor"],
      "armScopes": [],
      "buildPresets": [
        "build-g3519-at8236-debug",
        "build-g3519-at8236-release"
      ]
    },
    {
